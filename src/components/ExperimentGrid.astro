---
// Experiments as a grid of folder cards on a quiet dark container with a faint wash of the site palette.
import FolderCover from './FolderCover.astro';
import type { Experiment } from '../lib/experiments';

interface Props { experiments: Experiment[]; wash?: 'corners' | 'diagonal' | 'top' }
const { experiments, wash = 'corners' } = Astro.props;
---

<div class={`grid ${wash}`}>
  {experiments.map((e) => (
    <a class="card" href={`/experiments/${e.id}`}>
      <div class="art"><FolderCover experiment={e} /></div>
      <div class="body">
        <h3>{e.data.title}</h3>
        <p>{e.data.summary}</p>
      </div>
      <span class="arrow" aria-hidden="true">&rarr;</span>
    </a>
  ))}
</div>

<style>
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  @media (max-width: 960px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .grid { grid-template-columns: minmax(0, 1fr); } }
  .card { display: flex; flex-direction: column; gap: 16px; padding: 24px; border-radius: 16px; background-color: #0e0e0e; border: 1px solid var(--line);
    transition: border-color var(--t-tone) var(--ease), transform var(--t-move) var(--ease); }
  /* turquoise from one side, light purple from the other, both barely there */
  .corners .card { background-image: radial-gradient(120% 90% at 100% 0%, color-mix(in srgb, var(--pop) 13%, transparent), transparent 60%), radial-gradient(120% 90% at 0% 100%, color-mix(in srgb, var(--pop-2) 11%, transparent), transparent 60%); }
  .diagonal .card { background-image: linear-gradient(135deg, color-mix(in srgb, var(--pop) 10%, transparent), transparent 50%, color-mix(in srgb, var(--pop-2) 10%, transparent)); }
  .top .card { background-image: linear-gradient(180deg, color-mix(in srgb, color-mix(in srgb, var(--pop), var(--pop-2)) 13%, transparent), transparent 65%); }
  .card:hover { border-color: color-mix(in srgb, var(--pop-2) 40%, var(--line)); transform: translateY(-2px); }
  .card:active { transform: scale(0.99); }
  .art { padding: 8px 8px 0; }
  .body { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; flex: 1; }
  .body h3 { font-size: 20px; line-height: 28px; font-weight: 500; letter-spacing: -0.02em; }
  .body p { font-size: 14px; line-height: 20px; color: var(--mute); }
  .card > .arrow { align-self: flex-end; transition: transform var(--t-move) var(--ease); }
  .card:hover > .arrow { transform: translateX(4px); }
</style>
