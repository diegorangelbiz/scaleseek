---
import Mark from './Mark.astro';
import { getExperiments } from '../lib/experiments';

const experiments = await getExperiments();
const topics = [...new Set(experiments.map((e) => e.data.topic))];
---

<footer class="foot">
  <div class="wrap">
    <div class="brand">
      <a class="logo" href="/"><Mark />Scaleseek</a>
      <p>An independent log of AI experiments.<br />Made in El Paso, Texas.</p>
    </div>
    <nav class="cols" aria-label="Footer">
      <div>
        <h2>Site</h2>
        <ul>
          <li><a href="/experiments">Experiments</a></li>
          <li><a href="/method">Method</a></li>
          <li><a href="/about">About</a></li>
        </ul>
      </div>
      <div>
        <h2>Topics</h2>
        <ul>
          {topics.map((t) => <li><a href={`/experiments?topic=${encodeURIComponent(t)}`}>{t}</a></li>)}
        </ul>
      </div>
      <div>
        <h2>Contact</h2>
        <ul><li><a href="/about#contact">hello@scaleseek.com</a></li></ul>
      </div>
    </nav>
    <div class="legal">
      <small>&copy; {new Date().getFullYear()} Scaleseek</small>
      <a href="/privacy">Privacy</a>
      <a href="/terms">Terms</a>
    </div>
  </div>
</footer>

<style>
  .foot { border-top: 1px solid var(--line); margin-top: 48px; }
  .wrap { display: grid; grid-template-columns: 224px minmax(0, 560px); gap: 32px 80px; padding-block: 48px 24px; }
  .brand { display: flex; flex-direction: column; gap: 12px; align-items: flex-start; }
  .brand p { color: var(--mute); font-size: 14px; line-height: 20px; }
  .cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .cols h2 { font-size: 14px; line-height: 20px; font-weight: 500; margin-bottom: 12px; }
  .cols ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .cols a, .legal a { font-size: 14px; line-height: 20px; color: var(--mute); transition: color var(--t-tone) var(--ease); }
  .cols a:hover, .legal a:hover { color: var(--ink); }
  .legal { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 24px; padding-top: 24px; border-top: 1px solid var(--line); }
  .legal small { color: var(--dim); font-size: 12px; line-height: 16px; margin-right: auto; }
  .legal a { font-size: 12px; line-height: 16px; }
  @media (max-width: 760px) {
    .wrap { grid-template-columns: minmax(0, 1fr); padding-block: 40px 24px; }
    .cols { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
