---
// Faint dot lattice behind the hero. Random connections run along the mark's two angles,
// then the mark fades in, holds, and dissolves. Loops about every 18 seconds.
---
<canvas class="lattice" aria-hidden="true"></canvas>

<style>
  .lattice { position: absolute; inset: 0; width: 100%; height: 100%; display: block; pointer-events: none; }
</style>

<script>
  // The mark's edges run at slopes of about 1/2 and 1, so it is drawn exactly on a
  // square lattice with steps of (2,-1) and (1,1).
  const CYCLE = 18, T_FORM = 4, T_HOLD = 11, T_OFF = 15;
  const MOVES = [[2, -1], [1, 1]];
  const INK = '244,244,241', POP = '255,178,36';
  const PATHS = [
    [[0, 4], [8, 0], [16, 8], [8, 12], [0, 4]],
    [[2, 6], [-2, 8], [6, 16], [14, 12], [12, 10]],
  ];
  const clamp = (v: number, a: number, b: number) => Math.min(b, Math.max(a, v));
  const smooth = (v: number) => { v = clamp(v, 0, 1); return v * v * (3 - 2 * v); };

  type Edge = { a: number[]; b: number[]; on: number; off: number };
  type Link = { a: number[]; b: number[]; born: number; life: number };

  const canvas = document.querySelector<HTMLCanvasElement>('canvas.lattice');
  if (canvas) {
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const ptr = { x: 0, y: 0, on: false };
    let net: any = null, lastMs = 0, clock = 0;

    document.addEventListener('pointermove', (e) => {
      const r = canvas.getBoundingClientRect();
      ptr.x = e.clientX - r.left; ptr.y = e.clientY - r.top;
      ptr.on = ptr.x >= 0 && ptr.y >= 0 && ptr.x <= r.width && ptr.y <= r.height;
    });

    const build = (w: number, h: number) => {
      const wide = w >= 760, g = wide ? clamp(Math.floor(h / 26), 16, 22) : 13;
      const cols = Math.floor(w / g) + 1, rows = Math.floor(h / g) + 1;
      const x0 = (w - (cols - 1) * g) / 2, y0 = (h - (rows - 1) * g) / 2;
      const oi = clamp(Math.round((cols - 1) * (wide ? 0.77 : 0.5) - 9) + 2, 3, cols - 18);
      const oj = Math.max(1, Math.round((rows - 1 - 16) * 0.32));
      const edges: Edge[] = [];
      for (const p of PATHS) for (let k = 0; k < p.length - 1; k++) {
        const [ax, ay] = p[k], [bx, by] = p[k + 1], n = Math.abs(by - ay), dx = (bx - ax) / n, dy = (by - ay) / n;
        for (let s = 0; s < n; s++) edges.push({ a: [oi + ax + dx * s, oj + ay + dy * s], b: [oi + ax + dx * (s + 1), oj + ay + dy * (s + 1)], on: 0, off: 0 });
      }
      net = { w, h, g, cols, rows, x0, y0, edges, links: [] as Link[], cycle: -1, acc: 0, wide };
    };

    const schedule = () => {
      const n = net.edges.length, order = net.edges.map((_: Edge, i: number) => i);
      for (let i = n - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [order[i], order[j]] = [order[j], order[i]]; }
      order.forEach((ei: number, k: number) => {
        const e = net.edges[ei];
        e.on = T_FORM + (T_HOLD - T_FORM - 1.6) * Math.pow(k / (n - 1), 0.85);
        e.off = T_OFF + Math.random() * 1.5;
      });
    };

    const spawn = () => {
      let i: number, j: number;
      if (ptr.on && Math.random() < 0.6) {
        i = Math.round((ptr.x - net.x0) / net.g + (Math.random() - 0.5) * 6);
        j = Math.round((ptr.y - net.y0) / net.g + (Math.random() - 0.5) * 6);
      } else { i = Math.floor(Math.random() * net.cols); j = Math.floor(Math.random() * net.rows); }
      const m = MOVES[Math.floor(Math.random() * MOVES.length)];
      const s = (Math.random() < 0.5 ? 1 : -1) * (1 + Math.floor(Math.random() * 4));
      const i2 = i + m[0] * s, j2 = j + m[1] * s;
      if (i < 0 || j < 0 || i2 < 0 || j2 < 0 || i >= net.cols || i2 >= net.cols || j >= net.rows || j2 >= net.rows) return;
      net.links.push({ a: [i, j], b: [i2, j2], born: clock, life: 3 + Math.random() * 2 });
    };

    const frame = (ms: number) => {
      requestAnimationFrame(frame);
      const dt = Math.min(0.1, (ms - lastMs) / 1000 || 0); lastMs = ms;
      const dpr = Math.min(2, window.devicePixelRatio || 1), w = canvas.clientWidth, h = canvas.clientHeight;
      if (!w || !h) return;
      if (canvas.width !== Math.round(w * dpr) || canvas.height !== Math.round(h * dpr)) { canvas.width = Math.round(w * dpr); canvas.height = Math.round(h * dpr); }
      if (!net || net.w !== w || net.h !== h) build(w, h);
      const N = net; clock += dt;
      const cyc = Math.floor(clock / CYCLE), t = still ? 13 : clock % CYCLE;
      if (cyc !== N.cycle) { N.cycle = cyc; schedule(); }
      const P = (i: number, j: number) => [N.x0 + i * N.g, N.y0 + j * N.g];
      const fade = (x: number, y: number) =>
        (N.wide ? 0.3 + 0.7 * smooth((x / w - 0.3) / 0.45) : 0.5) * (1 - smooth((y - (h - 110)) / 110)) * smooth(y / 60);

      if (!still) {
        const rate = t < T_FORM ? 4.5 : t < T_HOLD ? 4.5 - 3.3 * (t - T_FORM) / (T_HOLD - T_FORM) : t < T_OFF ? 1.2 : 1.2 + 3.3 * (t - T_OFF) / (CYCLE - T_OFF);
        N.acc += rate * dt * Math.min(2.2, (w * h) / 260000);
        while (N.acc > 1) { N.acc--; spawn(); }
        N.links = N.links.filter((e: Link) => clock - e.born < e.life);
      }

      const g = canvas.getContext('2d')!;
      g.setTransform(dpr, 0, 0, dpr, 0, 0); g.clearRect(0, 0, w, h); g.lineCap = 'round';
      for (let j = 0; j < N.rows; j++) for (let i = 0; i < N.cols; i++) {
        const [x, y] = P(i, j), f = fade(x, y); if (f <= 0.01) continue;
        const near = ptr.on ? Math.exp(-((x - ptr.x) ** 2 + (y - ptr.y) ** 2) / (2 * 40 * 40)) : 0;
        g.fillStyle = `rgba(${INK},${(0.13 + 0.3 * near) * f})`; g.beginPath(); g.arc(x, y, 0.9, 0, 7); g.fill();
      }
      g.lineWidth = 0.75;
      for (const e of N.links as Link[]) {
        const age = clock - e.born, grow = smooth(age / (e.life * 0.5)), out = Math.pow(Math.sin(Math.PI * age / e.life), 1.5);
        const [ax, ay] = P(e.a[0], e.a[1]), [bx, by] = P(e.b[0], e.b[1]);
        g.strokeStyle = `rgba(${INK},${0.2 * out * fade((ax + bx) / 2, (ay + by) / 2)})`;
        g.beginPath(); g.moveTo(ax, ay); g.lineTo(ax + (bx - ax) * grow, ay + (by - ay) * grow); g.stroke();
      }
      g.lineWidth = 0.9;
      for (const e of N.edges as Edge[]) {
        if (t < e.on) continue;
        const out = smooth((t - e.on) / 1.6) * (1 - smooth((t - e.off) / 1.3)); if (out <= 0) continue;
        const [ax, ay] = P(e.a[0], e.a[1]), [bx, by] = P(e.b[0], e.b[1]);
        g.strokeStyle = `rgba(${POP},${0.3 * out * fade((ax + bx) / 2, (ay + by) / 2)})`;
        g.beginPath(); g.moveTo(ax, ay); g.lineTo(bx, by); g.stroke();
      }
    };
    requestAnimationFrame(frame);
  }
</script>
