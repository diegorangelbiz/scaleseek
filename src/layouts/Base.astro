---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import Mark from '../components/Mark.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const {
  title,
  description = 'Scaleseek is an independent log of AI experiments. Every test is filed with its question, its setup and its result.',
  noindex = false,
} = Astro.props;
const pageTitle = title ? `${title} | Scaleseek` : 'Scaleseek | An independent log of AI experiments';
const path = Astro.url.pathname;
const site = Astro.site ?? new URL('https://scaleseek.com');
const canonical = new URL(path, site).href;
const ogImage = new URL('/og.png', site).href;
const nav = [
  { href: '/experiments', label: 'Experiments' },
  { href: '/method', label: 'Method' },
  { href: '/about', label: 'About' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Scaleseek" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <title>{pageTitle}</title>
    <script is:inline>document.documentElement.classList.add('js');</script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="hd">
      <div class="bar">
        <a class="logo" href="/" aria-label="Scaleseek home"><Mark />Scaleseek</a>
        <nav class="nav" aria-label="Site">
          {nav.map((n) => (
            <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
        <a class="btn sm primary cta" href="/about#contact">Contact</a>
        <button class="toggle" type="button" aria-expanded="false" aria-controls="menu" aria-label="Open menu">
          <span></span><span></span>
        </button>
      </div>
    </header>
    <div class="menu" id="menu" hidden>
      <nav aria-label="Site menu">
        {[...nav, { href: '/about#contact', label: 'Contact' }].map((n, i) => (
          <a href={n.href} style={`--i:${i}`} aria-current={path.startsWith(n.href) && n.label !== 'Contact' ? 'page' : undefined}>{n.label}</a>
        ))}
      </nav>
    </div>
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />

    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.toggle')!;
      const menu = document.querySelector<HTMLElement>('#menu')!;
      const setOpen = (open: boolean) => {
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        document.body.classList.toggle('menu-open', open);
        if (open) { menu.hidden = false; requestAnimationFrame(() => menu.classList.add('open')); }
        else { menu.classList.remove('open'); setTimeout(() => { if (!menu.classList.contains('open')) menu.hidden = true; }, 500); }
      };
      toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
      menu.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) setOpen(false); });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) { setOpen(false); toggle.focus(); } });
      matchMedia('(min-width: 768px)').addEventListener('change', (m) => { if (m.matches) setOpen(false); });

      // sections rise into place once as they enter the viewport
      const io = new IntersectionObserver((entries) => {
        for (const en of entries) if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); }
      }, { rootMargin: '0px 0px -10% 0px' });
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    </script>
  </body>
</html>

<style>
  .hd { position: sticky; top: 0; z-index: 50; display: flex; justify-content: center; padding: 12px 16px 0; pointer-events: none; }
  .bar { pointer-events: auto; display: flex; align-items: center; gap: 32px; padding: 8px 8px 8px 16px; border: 1px solid var(--line); border-radius: 12px; background: color-mix(in srgb, var(--surface) 72%, transparent); backdrop-filter: blur(16px) saturate(140%); -webkit-backdrop-filter: blur(16px) saturate(140%); }
  .nav { display: flex; align-items: center; gap: 24px; font-size: 14px; line-height: 20px; }
  .nav a { color: var(--mute); padding: 4px 0; transition: color var(--t-tone) var(--ease); }
  .nav a:hover, .nav a[aria-current='page'] { color: var(--ink); }
  .nav a[aria-current='page'] { text-decoration: underline; text-decoration-color: var(--pop-2); text-underline-offset: 8px; }

  .toggle { display: none; position: relative; width: 40px; height: 32px; border: 0; border-radius: 6px; background: transparent; cursor: pointer; }
  .toggle span { position: absolute; left: 12px; right: 12px; height: 1.5px; background: var(--ink); border-radius: 2px; transition: transform var(--t-move) var(--ease); }
  .toggle span:first-child { transform: translateY(-4px); }
  .toggle span:last-child { transform: translateY(4px); }
  :global(.menu-open) .toggle span:first-child { transform: rotate(45deg); }
  :global(.menu-open) .toggle span:last-child { transform: rotate(-45deg); }

  .menu { position: fixed; inset: 0; z-index: 40; padding: 96px 16px 32px; background: color-mix(in srgb, var(--bg) 92%, transparent); backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px); opacity: 0; transition: opacity var(--t-tone) var(--ease); }
  .menu.open { opacity: 1; }
  .menu nav { display: flex; flex-direction: column; }
  .menu a { font-size: 30px; line-height: 36px; font-weight: 500; letter-spacing: -0.03em; padding: 12px 0; border-bottom: 1px solid var(--line); color: var(--mute); opacity: 0; transform: translateY(24px); transition: opacity var(--t-move) var(--ease), transform var(--t-move) var(--ease); transition-delay: calc(min(var(--i) * 60ms, 340ms)); }
  .menu a[aria-current='page'] { color: var(--ink); }
  .menu.open a { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .menu a { transform: none; transition: opacity var(--t-tone) var(--ease); }
    .toggle span { transition: opacity var(--t-tone) var(--ease); }
  }
  :global(body.menu-open) { overflow: hidden; }

  @media (max-width: 767px) {
    .hd { padding-inline: 12px; }
    .bar { width: 100%; justify-content: space-between; gap: 16px; padding-left: 12px; }
    .nav, .cta { display: none; }
    .toggle { display: block; }
  }
</style>
