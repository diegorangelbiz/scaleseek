---
import Base from '../layouts/Base.astro';
---

<Base title="About" description="About Scaleseek, an independent log of AI experiments.">
  <div class="wrap page">
    <article class="article">
      <h1>About Scaleseek</h1>
      <p class="lede">
        Scaleseek is a place to test what AI can and cannot do, and to keep an honest record of the results.
      </p>
      <div class="prose">
        <p>
          Every experiment follows the same format: a question, a setup and a result. Entries are never
          deleted. If a test was flawed or abandoned, it stays in the log and says so.
        </p>
        <p>Scaleseek is independent and is not sponsored by any model provider.</p>
        <h2 id="contact">Contact</h2>
        <p>hello@scaleseek.com</p>
      </div>
      <div class="btns">
        <a class="btn primary" href="/experiments">Browse experiments <span aria-hidden="true">&nearr;</span></a>
      </div>
    </article>
  </div>
</Base>
