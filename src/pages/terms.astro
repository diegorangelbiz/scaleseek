---
import Base from '../layouts/Base.astro';
---

<Base title="Terms" description="Terms for reading and reusing Scaleseek experiments.">
  <div class="wrap page">
    <article class="article">
      <a class="back" href="/">&larr; Home</a>
      <h1>Terms</h1>
      <p class="lede">Last updated Oct 29, 2026.</p>
      <div class="prose">
        <h2>Reading and sharing</h2>
        <p>
          You are welcome to read, link to and quote the experiments here. When you quote a result, please link
          back to the entry it came from so readers can see the setup.
        </p>
        <h2>No warranty</h2>
        <p>
          Experiments describe what happened under one setup at one point in time. Models change, and results may
          not hold for yours. Nothing here is professional advice, and the site is provided as is.
        </p>
        <h2>Corrections</h2>
        <p>
          If you find a mistake, write to hello@scaleseek.com. Corrections are added to the entry with a date,
          and the original text stays visible.
        </p>
      </div>
    </article>
  </div>
</Base>
